<mxfile host="app.diagrams.net">
  <diagram id="container" name="Container diagram (C4 level 2)">
    <mxGraphModel dx="1000" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Service Request Management System — Container diagram (C4 level 2)" style="text;html=1;fontSize=18;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="760" height="30" as="geometry" />
        </mxCell>

        <mxCell id="emp" value="&lt;b&gt;Employee&lt;/b&gt;&lt;br&gt;creates and tracks requests" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="agent" value="&lt;b&gt;Support agent&lt;/b&gt;&lt;br&gt;views, filters, changes status" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="300" y="60" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="op" value="&lt;b&gt;Operator&lt;/b&gt;&lt;br&gt;checks the system is up" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="200" height="60" as="geometry" />
        </mxCell>

        <mxCell id="fe" value="&lt;b&gt;Next.js frontend&lt;/b&gt; (runs in the browser)&lt;br&gt;TypeScript · React · Tailwind&lt;br&gt;&lt;font style=&quot;font-size:12px&quot;&gt;list · create form · details + status buttons · one API client (lib/api-client.ts)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="api" value="&lt;b&gt;Express API&lt;/b&gt; (Node.js · TypeScript) — port 4000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="330" width="820" height="250" as="geometry" />
        </mxCell>
        <mxCell id="mw" value="Middleware: helmet · CORS (frontend only) · JSON limit 100 kB · rate limit · error handler (one error shape, 503 when DB is down)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="370" width="780" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ctrl" value="&lt;b&gt;Routes / Controller&lt;/b&gt;&lt;br&gt;HTTP only: Zod validation,&lt;br&gt;status codes, JSON" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="80" y="440" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="svc" value="&lt;b&gt;Service&lt;/b&gt;&lt;br&gt;business rules: new = OPEN,&lt;br&gt;status transitions (404 / 409)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="310" y="440" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="repo" value="&lt;b&gt;Repository&lt;/b&gt;&lt;br&gt;database queries only&lt;br&gt;(Prisma, parameterised)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="540" y="440" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="health" value="&lt;b&gt;GET /api/health&lt;/b&gt;&lt;br&gt;200 / 503" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="760" y="440" width="100" height="80" as="geometry" />
        </mxCell>
        <mxCell id="layers-note" value="dependencies point one way →" style="text;html=1;fontSize=11;fontStyle=2;align=left;" vertex="1" parent="1">
          <mxGeometry x="80" y="530" width="220" height="20" as="geometry" />
        </mxCell>

        <mxCell id="db" value="&lt;b&gt;PostgreSQL 17&lt;/b&gt;&lt;br&gt;table service_requests&lt;br&gt;&lt;font style=&quot;font-size:11px&quot;&gt;enums · constraints · index on status · migrations&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=12;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="500" y="650" width="260" height="110" as="geometry" />
        </mxCell>
        <mxCell id="note" value="The browser never talks to the database. Only the API has DATABASE_URL (in .env, never in Git)." style="text;html=1;fontSize=12;fontStyle=2;align=left;whiteSpace=wrap;" vertex="1" parent="1">
          <mxGeometry x="60" y="680" width="400" height="50" as="geometry" />
        </mxCell>

        <mxCell id="e1" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="emp" target="fe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="agent" target="fe">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="HTTPS / JSON&lt;br&gt;(fetch via api-client)" style="endArrow=block;html=1;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="fe" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="GET /api/health&lt;br&gt;(curl / monitoring)" style="endArrow=block;html=1;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="op" target="api">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="ctrl" target="svc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" style="endArrow=block;html=1;strokeWidth=1.5;" edge="1" parent="1" source="svc" target="repo">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" value="SQL via Prisma" style="endArrow=block;html=1;strokeWidth=1.5;fontSize=12;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="repo" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" value="SELECT 1" style="endArrow=block;html=1;strokeWidth=1.5;fontSize=11;dashed=1;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="health" target="db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
