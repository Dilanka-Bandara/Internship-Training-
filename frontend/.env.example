# Copy to .env.local and adjust. Never commit .env / .env.local.

# Base URL of the Express API (built on Day 3)
NEXT_PUBLIC_API_URL=http://localhost:4000

# TEMPORARY: "true" shows sample data so the UI can be demoed before the API exists.
# Set to "false" (or remove) to call the real API. Removed on Day 4.
NEXT_PUBLIC_USE_MOCK_API=false
