# Copy to .env.test for automated tests. Never commit .env.test.
# Use a SEPARATE database — tests delete all rows before each test.
# The database name must end in _test or the tests refuse to run.
PORT=4001
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/service_requests_test?schema=public"
CORS_ORIGIN=http://localhost:3000
NODE_ENV=test
