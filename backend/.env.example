# Copy to .env and fill in. Never commit .env.
PORT=4000
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Special characters in the password must be URL-encoded (e.g. @ -> %40).
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/service_requests?schema=public"
# The only website allowed to call the API. Required when NODE_ENV=production.
CORS_ORIGIN=http://localhost:3000
NODE_ENV=development
# Optional: requests per client IP per minute on /api/requests (default 100).
RATE_LIMIT_PER_MINUTE=100
